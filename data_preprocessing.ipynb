## Imports & Expanded Sample Data
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# Expanded Sample Data to allow proper cleaning/outlier detection
data = [
    {'order_id': 1, 'cuisine': 'Fast Food', 'total_cost': 1450, 'distance_km': 4.2, 'timestamp': '2025-06-01 12:30'},
    {'order_id': 2, 'cuisine': 'Desi Cuisine', 'total_cost': 980, 'distance_km': 6.1, 'timestamp': '2025-06-01 13:45'},
    {'order_id': 3, 'cuisine': 'Chinese', 'total_cost': 2200, 'distance_km': 2.5, 'timestamp': '2025-06-01 19:15'},
    {'order_id': 4, 'cuisine': 'Fast Food', 'total_cost': 550, 'distance_km': 1.2, 'timestamp': '2025-06-01 08:20'},
    {'order_id': 5, 'cuisine': 'Desi Cuisine', 'total_cost': 12000, 'distance_km': 15.0, 'timestamp': '2025-06-01 21:00'}, # Outlier cost
    {'order_id': 6, 'cuisine': 'Continental', 'total_cost': 3100, 'distance_km': 5.0, 'timestamp': '2025-06-02 14:10'},
    {'order_id': 7, 'cuisine': 'Fast Food', 'total_cost': 850, 'distance_km': 3.1, 'timestamp': '2025-06-02 20:30'},
    {'order_id': 8, 'cuisine': 'Chinese', 'total_cost': 1650, 'distance_km': 4.0, 'timestamp': '2025-06-02 13:00'}
]

df = pd.DataFrame(data)
print("--- Raw Data Sample ---")
print(df.head(3))

  ## Data Cleaning & Feature Engineering
# 1. Convert timestamp column to datetime objects
df['timestamp'] = pd.to_datetime(df['timestamp'])

# 2. Check for missing values
print('--- Missing Values ---')
print(df.isnull().sum())
print('\n')

# 3. Remove outliers (Drops orders in the top 5% of costs, like order_id 5)
q_95 = df['total_cost'].quantile(0.95)
df_cleaned = df[df['total_cost'] < q_95].copy() 

# 4. Feature Engineering
df_cleaned['hour'] = df_cleaned['timestamp'].dt.hour
df_cleaned['day'] = df_cleaned['timestamp'].dt.day_name()

print('--- Cleaned Data Description ---')
print(df_cleaned.describe())
## Visualization & Aggregation
# Peak Hours Analysis
plt.figure(figsize=(8, 4))
df_cleaned.groupby('hour').size().plot(kind='bar', color='skyblue', edgecolor='black')
plt.title('Peak Order Hours')
plt.xlabel('Hour of Day')
plt.ylabel('Number of Orders')
plt.show()

# Cuisine Analysis
print('--- Average Cost by Cuisine ---')
print(df_cleaned.groupby('cuisine')['total_cost'].mean())

## Exporting Cleaned Data
# Save the cleaned dataframe to a CSV file
df_cleaned.to_csv('cleaned_orders.csv', index=False)
print('Success: Cleaned data saved to "cleaned_orders.csv"!')
